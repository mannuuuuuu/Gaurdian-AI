{
  "version": 2,
  "builds": [
    {
      "src": "server/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "client/index.html",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/(.*\\.js|.*\\.css|.*\\.png|.*\\.jpg|.*\\.ico|.*\\.json|.*\\.svg|.*\\.webp)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "RPC_URL": "@RPC_URL",
    "DEMO_MODE": "@DEMO_MODE",
    "GROQ_API_KEY": "@GROQ_API_KEY",
    "AI_MODEL": "@AI_MODEL",
    "DAILY_TOKEN_LIMIT": "@DAILY_TOKEN_LIMIT"
  }
}
